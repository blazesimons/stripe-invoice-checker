# --- Stripe Connect OAuth (required for "Connect with Stripe") ---
# Stripe Dashboard -> Settings -> Connect -> Onboarding options -> OAuth
# Add this redirect URI there: https://<your-domain>/api/auth/callback
STRIPE_CLIENT_ID=ca_...
# Platform secret key, used only to exchange the OAuth code for a token.
STRIPE_SECRET_KEY=sk_live_...
# Any long random string; encrypts the session cookie (falls back to STRIPE_SECRET_KEY if unset).
SESSION_SECRET=

# --- Billing ---
# Stripe Payment Link for the $19/month subscription (Dashboard -> Payment Links).
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=https://buy.stripe.com/...

# --- Optional ---
# Public origin, only needed if forwarded headers are unreliable (custom domain behind a proxy).
APP_URL=
